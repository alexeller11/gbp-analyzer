# ── GOOGLE OAUTH ─────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=SEU_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=SEU_CLIENT_SECRET

# ── BANCO DE DADOS ────────────────────────────────────────────────────────────
# PostgreSQL (Neon.tech, Railway, Supabase, etc.)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require

# ── SERVIDOR ──────────────────────────────────────────────────────────────────
APP_URL=https://SEU-APP.up.railway.app
PORT=3000
NODE_ENV=production

# ── AUTENTICAÇÃO ──────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 64
JWT_SECRET=UMA_STRING_LONGA_E_SEGURA_COM_PELO_MENOS_64_CARACTERES

# ── IA (Groq) ─────────────────────────────────────────────────────────────────
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
