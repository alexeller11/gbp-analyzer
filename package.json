    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "@trpc/server": "^11.6.0",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "tsx": "^4.19.1",
    "vite": "^7.1.7",
    "esbuild": "^0.25.0",
    "dotenv": "^17.2.2",
    "zod": "^4.1.12",
    "cookie": "^1.0.2",
    "jose": "6.1.0",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4",
