{
  "name": "gbp-analyzer-app",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist --loader:.ts=ts",
    "start": "node dist/index.js",
    "db:push": "drizzle-kit push --force"
  },
  "dependencies": {
    "@google/genai": "^1.15.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.44.5",
    "esbuild": "^0.25.12",
    "express": "^4.21.2",
    "jose": "6.1.0",
    "pg": "^8.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.1",
    "typescript": "5.9.3"
  }
}
